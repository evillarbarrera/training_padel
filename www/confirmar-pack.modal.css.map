
  /* Inline styles for the modal to ensure self-containment */
  .modal-content {
    --background: white;
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: white;
  }

  .close-btn {
    position: absolute;
    top: 15px;
    right: 15px;
    z-index: 10;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    cursor: pointer;
  }

  .modal-image-container {
    height: 200px;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .modal-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .modal-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.4));
  }

  .modal-info {
    padding: 25px;
    text-align: center;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pack-title {
    font-size: 24px;
    font-weight: 800;
    color: #111;
    margin: 0;
    line-height: 1.2;
  }

  .coach-name {
    font-size: 14px;
    font-weight: 600;
    color: #666;
    margin: 5px 0 20px;
  }

  .price-container {
    margin-bottom: 25px;
  }

  .price-badge {
    background: #f2f2f7;
    padding: 10px 25px;
    border-radius: 20px;
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    transition: all 0.3s ease;
  }

  .price-badge.has-discount {
    background: #e1f5fe;
    color: #0288d1;
    transform: scale(1.05);
  }

  .original-price {
    font-size: 14px;
    color: #999;
    text-decoration: line-through;
    margin-top: 5px;
    font-weight: 500;
  }

  .coupon-section {
    width: 100%;
    margin-bottom: 25px;
  }

  .coupon-input-wrapper {
    width: 100%;
  }

  .input-container {
    display: flex;
    align-items: center;
    background: #f9f9f9;
    border: 1px solid #eee;
    padding: 8px 12px;
    border-radius: 12px;
    gap: 10px;
  }

  .coupon-icon {
    font-size: 20px;
    color: #888;
  }

  .input-container input {
    border: none;
    background: transparent;
    flex-grow: 1;
    font-size: 14px;
    outline: none;
    width: 100px;
  }

  .apply-btn {
    background: #111;
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .apply-btn:disabled {
    opacity: 0.5;
  }

  .error-msg {
    color: #ef5350;
    font-size: 12px;
    margin: 5px 0 0;
    text-align: left;
    padding-left: 5px;
  }

  .coupon-applied {
    background: #f1f8e9;
    border: 1px solid #c5e1a5;
    padding: 10px 15px;
    border-radius: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .applied-info {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #33691e;

    ion-icon {
      font-size: 18px;
    }
  }

  .discount-amount {
    margin-left: 5px;
    font-weight: 800;
  }

  .remove-btn {
    background: transparent;
    border: none;
    color: #c62828;
    font-size: 12px;
    font-weight: 700;
    padding: 4px;
    cursor: pointer;
  }

  .currency {
    font-size: 16px;
    font-weight: 600;
    color: #111;
  }

  .amount {
    font-size: 28px;
    font-weight: 900;
    color: #111;
  }

  .details-grid {
    display: flex;
    gap: 20px;
    margin-bottom: 25px;
  }

  .detail-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #666;
    font-size: 14px;
    font-weight: 500;

    ion-icon {
      color: var(--ion-color-primary);
      font-size: 18px;
    }
  }

  .info-box {
    background: rgba(var(--ion-color-primary-rgb), 0.05);
    padding: 15px;
    border-radius: 12px;
    margin-bottom: 30px;
    display: flex;
    gap: 10px;
    text-align: left;

    ion-icon {
      color: var(--ion-color-primary);
      font-size: 20px;
      flex-shrink: 0;
      margin-top: 2px;
    }

    p {
      margin: 0;
      font-size: 13px;
      color: #444;
      line-height: 1.4;
    }
  }

  .actions {
    width: 100%;
    margin-top: auto;
  }

  .confirm-btn {
    font-weight: 700;
    --box-shadow: 0 8px 20px rgba(var(--ion-color-primary-rgb), 0.3);
    margin-bottom: 10px;
    height: 50px;
    font-size: 16px;
  }
